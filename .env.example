# .env.example — Copy this to .env and fill in your values.
# NEVER commit the actual .env file to source control.

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,storeville.app,.storeville.app

# Internal secret for server-to-server Django ↔ Next.js calls (never use default in prod)
INTERNAL_SYNC_SECRET=replace-with-a-long-random-hex-string

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=storeville_db
POSTGRES_USER=storeville_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://storeville_user:replace-with-a-strong-password@postgres:5432/storeville_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-a-random-hex-string
REDIS_URL=redis://:replace-with-a-random-hex-string@redis:6379/0

# ── ngrok (LOCAL DEV ONLY) ────────────────────────────────────────────────────
# Provides a stable public HTTPS domain for Google OAuth during local development.
# Get your authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
# Claim your free static domain: https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken
NGROK_URL=https://your-static-domain.ngrok-free.dev

# ── Better Auth (Next.js auth server) ────────────────────────────────────────
# DEV  → set to your ngrok static domain (same as NGROK_URL above)
# PROD → set to your real domain in your hosting environment (e.g., Render/Vercel)
#        NEVER commit a production value here
BETTER_AUTH_URL=https://your-static-domain.ngrok-free.dev
BETTER_AUTH_SECRET=replace-with-a-long-random-hex-string

# ── Internal URL (server-to-server, stays inside Docker network) ──────────────
# The address Next.js can reach itself on inside Docker. Always http://localhost:3000.
INTERNAL_APP_URL=http://localhost:3000

# ── Gunicorn (optional overrides) ────────────────────────────────────────────
# GUNICORN_WORKERS=5        # Defaults to (2 × CPU cores) + 1
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info   # debug | info | warning | error | critical
